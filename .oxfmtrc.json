{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "semi": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules/",
    ".next/",
    "out/",
    "build/",
    "dist/",
    ".maintenance/",
    ".vercel/",
    "coverage/",
    "test-results/",
    "playwright-report/",
    "blob-report/",
    ".kilo/",
    "src/payload-types.ts",
    "src/payload-generated-schema.ts",
    "src/app/(payload)/admin/importMap.js",
    "src/migrations/",
    "next-env.d.ts",
    "pnpm-lock.yaml",
    "public/assets/visual-editor/",
    "media/",
    "typesense-data/",
    "migration/raw/",
    "migration/extracted/",
    "migration/**/*.json",
    "seed/data/"
  ]
}
