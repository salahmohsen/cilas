# Postgres connection string, used by the postgres adapter in
# src/payload.config.ts. Required.
DATABASE_URL=

# Secret used by Payload to sign tokens and encrypt data. Required.
# Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=

# Cloudflare R2 storage, used by the s3Storage plugin for the media collection.
# The plugin is registered unconditionally with disableLocalStorage: true, so
# uploads fail if these are unset — media is never written to local disk.
# All five are required in any environment where you upload an image.
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT already includes the https:// scheme, e.g.
# https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Public base URL the admin panel serves uploads from, e.g.
# https://<bucket>.r2.dev — must include the scheme.
R2_PUBLIC_URL=
# R2 uses auto (default); local RustFS uses us-east-1.
R2_REGION=auto

# Transactional email (review notifications, password resets). Unset = console.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@ci-las.org
# Who newsletters go to is set in Admin → Mailing lists (each list is a
# Resend segment), not here. Without RESEND_API_KEY, signup and sending are off.

# "Continue with Google" on the login page. Unset = the button is hidden.
# Google Cloud → OAuth client (Web). Authorized redirect URI:
# <NEXT_PUBLIC_SERVER_URL>/api/users/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Movie picker in Payload. TMDB account → Settings → API → Read Access Token.
# Keep this server-side. Free access requires noncommercial use and attribution.
TMDB_API_READ_TOKEN=

# Cloudflare Turnstile on the contact and application forms. Set both or
# neither: the secret alone refuses every submission. Unset = honeypot only.
# Cloudflare dashboard → Turnstile → Add widget (managed mode, your domains).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Web Push to phones and desktops (Settings → Notifications → On your devices).
# Set both keys or neither: without them the device switch is hidden and no push
# is sent. Generate a pair once, keep it forever (a new pair drops every device):
#   npx web-push generate-vapid-keys
# VAPID_SUBJECT is how a push service can reach you: mailto:you@example.org
# or an https:// URL. It defaults to mailto:<EMAIL_FROM_ADDRESS>.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# PostHog analytics (EU cloud, free plan): cookieless, public pages only. See
# docs/analytics.md. Unset = no analytics and no dashboard widgets.
# The two NEXT_PUBLIC_ values are also build arguments (Dockerfile).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# The admin dashboard reads the numbers back with these three (server only).
# The key is a personal API key with the "Query: read" scope and nothing else.
POSTHOG_API_HOST=https://eu.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=

# Private Spaces search. Disabled until migration, key audit and initial rebuild.
# See docs/adr/0010-private-spaces-search.md. Server-only keys, separate from public search.
PRIVATE_SPACES_SEARCH=false
PRIVATE_SPACES_SEARCH_KEYS_VERIFIED=false
# Optional. Search-only, for community_articles alone. Without it, the key is derived from TYPESENSE_API_KEY.
TYPESENSE_COMMUNITY_SEARCH_KEY=
TYPESENSE_PRIVATE_SEARCH_KEY=
TYPESENSE_PRIVATE_WRITE_KEY=
# Dedicated private engine in Dokploy. Omit these three to share the local test engine.
TYPESENSE_PRIVATE_HOST=
TYPESENSE_PRIVATE_PORT=
TYPESENSE_PRIVATE_PROTOCOL=

# Signs administrators' Claude and ChatGPT connections (Admin → Connected
# assistants). Required by a production server, 32 characters or more; a build
# does not need it. Generate once: openssl rand -hex 32
# Changing it ends every connection: each person has to connect again.
PMOAUTH_TOKEN_PEPPER=

# Spaces scheduler: Dokploy calls POST /api/cron/spaces hourly with
# "Authorization: Bearer <CRON_SECRET>". At least 32 characters; without it the
# route refuses every call. Generate: openssl rand -base64 48
CRON_SECRET=
