{
  "name": "CILAS",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "node scripts/install-commit-hooks.mjs",
    "hooks:install": "node scripts/install-commit-hooks.mjs",
    "test:commit-hooks": "node --test tests/commit-hooks.test.mjs",
    "check:commit-quality": "node scripts/check-commit-quality.mjs",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "db:seed": "npx tsx seed/index.ts",
    "db:snapshot": "npx tsx seed/snapshot-export.ts",
    "db:migrate": "cross-env NODE_OPTIONS=\"--no-deprecation --conditions=production\" payload migrate",
    "db:migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "db:reset": "pnpm db:migrate:create && pnpm payload migrate:fresh --force-accept-warning && pnpm db:seed",
    "lint": "oxlint .",
    "typecheck": "tsgo --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:production": "playwright test --config=playwright.production.config.ts",
    "test:unit": "vitest run tests/unit --no-isolate",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "test:seo": "node scripts/check-seo.mjs",
    "analytics:check": "tsx scripts/check-posthog-queries.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@brainwebuk/payload-plugin-mcp-oauth": "0.5.1",
    "@marsidev/react-turnstile": "1.6.2",
    "@payload-inline-visual-editor/core": "1.0.1",
    "@payload-inline-visual-editor/react": "1.0.1",
    "@payloadcms/db-postgres": "3.91.0",
    "@payloadcms/email-resend": "3.91.0",
    "@payloadcms/live-preview-react": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/plugin-form-builder": "3.91.0",
    "@payloadcms/plugin-import-export": "3.91.0",
    "@payloadcms/plugin-mcp": "3.91.0",
    "@payloadcms/plugin-redirects": "3.91.0",
    "@payloadcms/plugin-seo": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@payloadcms/storage-s3": "3.91.0",
    "@payloadcms/ui": "3.91.0",
    "@radix-ui/react-accordion": "^1.2.21",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-direction": "^1.1.5",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-form": "1.33.5",
    "@ui-sdk/core": "0.1.0-beta.1",
    "@ui-sdk/react": "0.1.0-beta.1",
    "boring-avatars": "^2.0.4",
    "cn": "^0.4.0",
    "cross-env": "^7.0.3",
    "date-fns": "^4.4.0",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "lucide-react": "^1.49.0",
    "motion": "^13.4.6",
    "next": "16.4.6",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "payload": "3.91.0",
    "payload-inline-visual-editor": "1.0.1",
    "payload-oauth2": "^1.0.21",
    "payload-plugin-llms-txt": "0.2.0",
    "payload-theme": "0.10.0",
    "pg": "8.20.0",
    "posthog-js": "^1.444.0",
    "posthog-node": "^5.61.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-email": "6.11.3",
    "react-instantsearch": "^7.52.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "shadcn": "^4.23.0",
    "sharp": "0.35.5",
    "simple-icons": "16.32.0",
    "tw-animate-css": "^1.4.0",
    "typesense": "^3.1.1",
    "typesense-instantsearch-adapter": "^3.0.2",
    "undici": "7.30.1",
    "unified": "11.0.5",
    "web-push": "^3.6.7",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "16.3.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "22.19.9",
    "@types/opentype.js": "^1.3.10",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "^3.6.4",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "4.5.2",
    "esbuild": "0.25.12",
    "jose": "5.10.0",
    "jsdom": "28.0.0",
    "lefthook": "2.2.2",
    "opentype.js": "1.3.4",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "4.22.4",
    "typescript": "5.7.3",
    "vite": "^7.3.7",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=20.18.1",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "overrides": {
      "@payloadcms/plugin-mcp>@modelcontextprotocol/sdk": "1.32.2",
      "@payloadcms/plugin-mcp>zod": "4.6.6",
      "source-map-js@<1.2.2": "^1.2.2",
      "systeminformation@<5.33.16": "^5.33.18",
      "dompurify@<3.4.16": "^3.4.17",
      "undici@>=7.0.0 <7.30.1": "7.30.1",
      "postcss-selector-parser@<6.1.5": "^6.1.5",
      "fast-uri@>=3.0.0 <3.1.9": "^3.1.9",
      "csv-parse@<7.0.2": "^7.0.2",
      "esbuild@<0.25.0": "^0.25.12",
      "vite@>=7.0.0 <7.3.7": "^7.3.7",
      "happy-dom@<21.0.4": "^21.0.4",
      "ip-address@<10.7.4": "^10.7.4",
      "qs@>=6.7.0 <6.16.1": "^6.16.1",
      "graphql-scalars@<2.0.1": "^2.0.1",
      "follow-redirects@<1.16.2": "^1.16.2",
      "glob@>=9.0.0 <14.0.2": "^14.0.3",
      "@ts-morph/common>minimatch": "^11.0.8"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher@2.6.0",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "patchedDependencies": {
      "deepmerge@4.3.1": "patches/deepmerge@4.3.1.patch",
      "payload-theme@0.10.0": "patches/payload-theme@0.10.0.patch"
    }
  }
}
